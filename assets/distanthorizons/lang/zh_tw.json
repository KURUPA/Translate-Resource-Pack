    "distanthorizons.config.common.logging.warning.showGarbageCollectorWarning": "顯示垃圾回收器警告",
    "distanthorizons.config.common.logging.warning.showHighVanillaRenderDistanceWarning": "顯示高原生渲染距離警告",
